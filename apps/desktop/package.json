{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.0-rc.5",
  "private": true,
  "description": "Electron desktop shell for DeepSeek Harness — bundles the dsh web backend and loads it in a window (一体式).",
  "license": "MIT",
  "main": "electron.main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "gen:ico": "node scripts/gen-icon-ico.mjs",
    "build:runtime": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.4"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "copyright": "MIT",
    "files": [
      "electron.main.cjs",
      "preload.cjs",
      "assets"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "harness"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lxlmaster",
        "repo": "deepseek-harness"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
